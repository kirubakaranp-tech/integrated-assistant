# Copy this file to .env and put your own key in it.
# Never commit .env - it is already in .gitignore.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# No OpenAI credit? Groq has a free plan (no credit card):
# put a key from https://console.groq.com/keys in OPENAI_API_KEY,
# then use these two lines instead of the OPENAI_MODEL line above.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# Orders database (PostgreSQL)
# The app uses the read-only user:
DATABASE_URL=postgresql://assistant_readonly:assistant123@localhost:5432/orders_db
# Only used once by "python -m database.setup" - put your postgres password here:
DATABASE_ADMIN_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres

# Frontend address(es) allowed by CORS, separated by commas
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
